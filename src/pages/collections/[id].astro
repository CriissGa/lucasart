---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Image from '../../components/PortfolioImage.astro';
import { getPortfolio } from '../../data/content.js';

// Astro genera una ruta por serie a partir de la selección central.
export async function getStaticPaths() {
  const { collections } = await getPortfolio();
  return collections.map((collection) => ({ params: { id: collection.id }, props: { collection } }));
}
const { collection } = Astro.props;
---

<Layout title={`${collection.title} | Lucas Taylor Photography`} description={collection.description}>
  <Navbar />
  <main>
    <header class="relative isolate flex min-h-[70svh] items-end overflow-hidden">
      <Image src={collection.cover} alt={`${collection.title} collection cover`} class="absolute inset-0 h-full w-full object-cover opacity-75" widths={[640, 1200, 1920]} sizes="100vw" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/25 to-black/25"></div>
      <div class="section-wrap relative pb-12 pt-28" data-reveal>
        <a href="/collections" class="mb-7 inline-block text-xs font-bold uppercase tracking-widest text-white hover:text-red-400">← All collections</a>
        <p class="eyebrow mb-4">{collection.eyebrow}</p>
        <h1 class="display-title">{collection.title}</h1>
        <p class="mt-6 max-w-lg text-lg text-neutral-200">{collection.description}</p>
      </div>
    </header>
    <section class="section-wrap py-12 sm:py-16" aria-label={`${collection.title} photo gallery`}>
      <div class="mb-7 flex items-end justify-between gap-4" data-reveal><p class="eyebrow">Selected frames / {collection.photos.length}</p><p class="text-sm text-neutral-500">Lucas Taylor © 2026</p></div>
      <!-- Dos columnas con fotos de alturas naturales crean ritmo sin recortar la obra. -->
      <div class="columns-1 gap-5 space-y-5 sm:columns-2 lg:gap-7 lg:space-y-7">
        {collection.photos.map((img, index) => (
          <figure class="group break-inside-avoid overflow-hidden bg-neutral-900" data-reveal>
            <Image src={img} alt={`${collection.title} photograph ${index + 1} by Lucas Taylor`} class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.025]" widths={[500, 900, 1400]} sizes="(min-width: 640px) 50vw, 100vw" loading="lazy" />
          </figure>
        ))}
      </div>
      <div class="mt-14 border-t border-white/15 pt-8 text-center" data-reveal>
        <p class="eyebrow mb-4">Have a project in mind?</p>
        <a class="button-primary" href="/contact">Let's make something ↗</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
