---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Lucas Taylor | Photographer & Videographer', description = 'Concert, portrait and street photography by Lucas Taylor in Phoenix, Arizona.' } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Cargar Google Fonts (Plus Jakarta Sans) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">

	</head>
	<body>
		<slot />
		<script>
			import gsap from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			gsap.registerPlugin(ScrollTrigger);
			// Todos los elementos marcados aparecen al entrar en pantalla; respeta movimiento reducido.
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
					gsap.from(element, { y: 36, opacity: 0, duration: .8, ease: 'power2.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
				});
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #050505; /* Tono oscuro equivalente a bg-slate-950 */
	
	}
</style>
