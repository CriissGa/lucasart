---
import Image from './PortfolioImage.astro';
import { getPortfolio } from '../data/content.js';
import heroBackgroundFallback from '../assets/collections/concerts/DSC09979.webp';
import heroFeaturedFallback from '../assets/collections/portraits/DSC03613.webp';
const { siteImages } = await getPortfolio();
---

<section class="relative isolate min-h-[min(900px,100svh)] overflow-hidden bg-black text-white">
  <Image src={siteImages.heroBackground?.asset ? siteImages.heroBackground : heroBackgroundFallback} alt="Cantante en directo entre luces y público" class="absolute inset-0 h-full w-full object-cover opacity-60" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" />
  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/65 to-black/10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/25"></div>
  <div class="relative mx-auto grid min-h-[min(900px,100svh)] max-w-7xl items-center gap-10 px-6 pb-16 pt-32 lg:grid-cols-[1.1fr_.9fr] lg:px-10">
    <div class="max-w-3xl" data-intro>
      <p class="eyebrow mb-6">Phoenix, Arizona / Photographer & videographer</p>
      <h1 class="display-title">Feel the<br /><span class="text-red-500">moment.</span></h1>
      <p class="mt-7 max-w-xl text-base leading-relaxed text-neutral-200 sm:text-lg">Concerts, portraits and street stories through the lens of Lucas Taylor.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="button-primary" href="/collections">Explore the work <span aria-hidden="true">↗</span></a>
        <a class="button-secondary" href="/contact">Let's collaborate</a>
      </div>
    </div>
    <div class="hidden justify-end lg:flex" data-book>
      <div class="relative w-[290px] rotate-[-6deg] border border-white/20 bg-neutral-950 p-3 shadow-[0_30px_100px_#000] xl:w-[340px]">
        <div class="relative aspect-[3/4] overflow-hidden">
          <Image src={siteImages.heroFeatured?.asset ? siteImages.heroFeatured : heroFeaturedFallback} alt="Fotografía seleccionada del archivo de Lucas Taylor" class="h-full w-full object-cover" widths={[400, 700]} sizes="340px" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 to-transparent"></div>
        </div>
        <div class="flex justify-between pt-3 font-mono text-[10px] uppercase tracking-widest text-neutral-400"><span>Lucas Taylor</span><span data-current-year>{new Date().getFullYear()}</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  // Una entrada corta conserva el efecto editorial y deja ver la foto enseguida.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.from('[data-intro] > *', { y: 28, opacity: 0, duration: .8, stagger: .12, ease: 'power2.out' });
    gsap.from('[data-book]', { y: 40, rotate: 8, opacity: 0, duration: 1.1, delay: .3, ease: 'power2.out' });
  }
</script>
