---
import Image from './PortfolioImage.astro';
import { getPortfolio } from '../data/content.js';
const { siteImages } = await getPortfolio(Astro.locals);
import lucasHeroImg from '../assets/images/lucas1.webp';
---
<section class="section-wrap grid items-center gap-8 py-14 sm:py-18 lg:grid-cols-2 lg:gap-12 lg:py-20">
  <div data-reveal>
    <p class="eyebrow mb-4">Behind the lens</p>
    <h2 class="section-title">Meet the<br /><em>maker.</em></h2>
    <p class="mt-5 max-w-xl text-neutral-400">I'm Lucas, a Phoenix based photographer and videographer drawn to live energy, honest portraits and stories in motion.</p>
    <a href="/about" class="mt-6 inline-block border-b border-red-500 pb-2 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:text-red-400">More about me ↗</a>
  </div>
  <div data-reveal class="relative overflow-hidden">
    <Image src={siteImages.profilePortrait?.asset ? siteImages.profilePortrait : lucasHeroImg} alt="Lucas Taylor, fotógrafo y videógrafo" class="maker-image max-h-[600px] w-full object-contain" widths={[500, 900]} sizes="(min-width: 1024px) 50vw, 100vw" />
  </div>
</section>

<style>
  .maker-image {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 90%, transparent 100%);
  }
</style>
