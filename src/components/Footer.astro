---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-red-950/60 bg-black text-neutral-400 py-10 px-6 shadow-2xl">
	<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-5 text-center text-sm font-mono">
		
		<!-- BRAND / COPYRIGHT -->
		<div class="flex max-w-full flex-wrap items-center justify-center gap-x-2 gap-y-1">
			<span class="text-white font-black tracking-widest uppercase">LUCAS <span class="text-red-600">ART</span></span>
			<span class="text-neutral-600">|</span>
			<p class="text-neutral-500 text-xs">© {currentYear} Created by CyberBalance - All rights reserved.</p>
		</div>

		<!-- LOCATION & TAGLINE -->
		<p class="flex max-w-full flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-neutral-500 tracking-wider uppercase">
			<span class="inline-block w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
			Phoenix, Arizona <span class="text-neutral-700">•</span> Photographer & Videographer
		</p>

	</div>
</footer>