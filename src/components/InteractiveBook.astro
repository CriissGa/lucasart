---
import Image from './PortfolioImage.astro';
import { getPortfolio } from '../data/content.js';
const { collections, book, siteImages } = await getPortfolio();

// Esta lista decide qué diez fotos aparecen y en qué orden se leen las páginas.
// Cada entrada incluye su colección para que la galería final tenga enlaces útiles.
const defaultBookPhotos = [
  { image: collections[0].photos[0], title: 'The stage', href: '/collections/concerts', alt: 'Singer on stage in dramatic light' },
  { image: collections[0].photos[1], title: 'The sound', href: '/collections/concerts', alt: 'Live performer under concert lighting' },
  { image: collections[1].photos[0], title: 'The portrait', href: '/collections/portraits', alt: 'Atmospheric portrait in a studio' },
  { image: collections[1].photos[1], title: 'The presence', href: '/collections/portraits', alt: 'Creative portrait with dramatic lighting' },
  { image: collections[2].photos[0], title: 'The movement', href: '/collections/street', alt: 'Skateboarder in motion at a street event' },
  { image: collections[2].photos[1], title: 'The street', href: '/collections/street', alt: 'Street action captured in motion' },
  { image: collections[0].photos[2], title: 'The crowd', href: '/collections/concerts', alt: 'Live music moment from the crowd' },
  { image: collections[1].photos[2], title: 'The detail', href: '/collections/portraits', alt: 'Intimate editorial portrait' },
  { image: collections[2].photos[2], title: 'The city', href: '/collections/street', alt: 'Skate culture in the city' },
  { image: collections[0].photos[3], title: 'The encore', href: '/collections/concerts', alt: 'Concert photograph with stage lighting' },
];
const bookPhotos = book?.photos?.length === 10
  ? book.photos.map((image, index) => ({
      image, title: image.title || defaultBookPhotos[index].title,
      alt: image.alt || defaultBookPhotos[index].alt,
      href: image.category ? '/collections/' + image.category : defaultBookPhotos[index].href,
    }))
  : defaultBookPhotos;
if (book && book.photos?.length !== 10) console.warn('[Sanity] El libro necesita 10 fotos; se usa la selección de respaldo.');
const sheets = Array.from({ length: 5 }, (_, index) => ({
  front: bookPhotos[index * 2],
  back: bookPhotos[index * 2 + 1],
}));
---

<section class="photobook relative isolate overflow-hidden bg-[#090909] text-white" aria-labelledby="book-title" data-photobook>
  <!-- Un halo y las líneas finas dan profundidad sin competir con las fotografías. -->
  <div class="book-atmosphere pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="book-rule pointer-events-none absolute inset-x-0 top-0 h-px bg-white/15" aria-hidden="true"></div>

  <div class="book-inner section-wrap relative flex min-h-[100svh] flex-col items-center justify-between text-center">
    <header class="book-heading relative z-40 mx-auto max-w-3xl">
      <p class="eyebrow mb-3">A visual archive / Volume 01</p>
      <h2 id="book-title" class="text-4xl font-black uppercase leading-none tracking-[-.06em] sm:text-5xl lg:text-6xl">Lucas <span class="text-red-500">Taylor</span></h2>
      <p class="mt-3 text-xs tracking-[.18em] text-neutral-400 sm:text-sm">Five leaves. Ten frames. One story.</p>
    </header>

    <!-- La escena mantiene la perspectiva; cada hoja gira alrededor de su borde izquierdo. -->
    <div class="book-scene relative z-20 shrink-0" aria-label="Five page photography book">
      <div class="book-shadow pointer-events-none absolute -bottom-8 left-1/2 h-10 w-[130%] -translate-x-1/2 rounded-[50%] bg-black blur-xl"></div>
      <div class="book-wrapper relative h-full w-full">
        <div class="book-spine pointer-events-none absolute -left-3 top-0 z-40 h-full w-4 rounded-l-md bg-gradient-to-r from-black via-neutral-700 to-black shadow-xl" aria-hidden="true"></div>
        <div class="book-cover-back page absolute inset-0 origin-left rounded-r-lg border border-white/15 bg-neutral-900 shadow-[12px_18px_35px_#000]">
          <div class="flex h-full flex-col justify-between p-5 text-left">
            <span class="book-small text-neutral-400">L / T — 2026</span>
            <span class="book-small text-right text-neutral-500">END OF VOLUME 01</span>
          </div>
        </div>

        {sheets.map((sheet, index) => (
          <div class={`book-page page page-${index + 1} absolute inset-0 origin-left`} style={`z-index: ${20 - index};`}>
            {[sheet.front, sheet.back].map((photo, faceIndex) => (
              <div class={`page-face ${faceIndex === 0 ? 'page-front rounded-r-lg' : 'page-back rounded-l-lg'} absolute inset-0 border border-neutral-500/40 bg-[#e9e7e1] p-[5px] shadow-[6px_10px_24px_#0009]`}>
                <div class="relative h-full w-full overflow-hidden bg-neutral-900">
                  <Image src={photo.image} alt={photo.alt} class="book-image h-full w-full object-cover" width={500} height={700} loading="lazy" />
                </div>
              </div>
            ))}
          </div>
        ))}

        <div class="book-cover-front page absolute inset-0 z-30 origin-left">
          <div class="page-face page-front absolute inset-0 overflow-hidden rounded-r-lg border border-white/30 bg-black shadow-[15px_24px_55px_#000]">
            <Image src={bookPhotos[0].image} alt="" aria-hidden="true" class="book-cover-photo absolute inset-0 h-full w-full object-cover" width={500} height={700} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-black/25"></div>
            <div class="absolute inset-3 border border-white/35"></div>
            <div class="relative flex h-full flex-col justify-between p-5 text-left sm:p-7">
              <div class="flex items-start justify-between gap-2">
                <span class="book-small text-white/85">SELECTED WORKS</span>
                <span class="book-small text-white/85">VOL. 01</span>
              </div>
              <div>
                <span class="block text-[clamp(1.5rem,4vw,3.3rem)] font-black uppercase leading-[.9] tracking-[-.08em]">Lucas<br />Taylor</span>
                <span class="book-small mt-3 block text-white/75">PHOTOGRAPHY / PHOENIX</span>
              </div>
              <span class="book-small border-t border-white/50 pt-3 text-white/80">TEN FRAMES, ONE POINT OF VIEW</span>
            </div>
          </div>
          <div class="page-face page-back absolute inset-0 flex items-center justify-center rounded-l-lg border border-neutral-500/40 bg-[#e9e7e1] p-5 text-neutral-900 shadow-xl">
            <p class="max-w-44 border-y border-neutral-500 py-5 text-center text-xs font-semibold uppercase leading-relaxed tracking-[.16em]">Every moment deserves to be felt.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="book-bottom relative z-40 flex w-full items-end justify-between gap-4">
      <span class="book-small text-left text-neutral-500">PHOENIX, ARIZONA<br />© 2026</span>
      <div class="min-w-36 max-w-48 flex-1 text-center">
        <span class="book-small text-neutral-300">SCROLL TO TURN THE PAGES ↓</span>
        <div class="mt-3 h-px w-full bg-white/20"><div class="book-progress h-px w-full origin-left scale-x-0 bg-red-500"></div></div>
      </div>
      <span class="book-small text-right text-neutral-500">CONCERTS / PORTRAITS<br />STREET / STORIES</span>
    </div>
  </div>

  <!-- Al terminar el libro, las diez imágenes quedan disponibles como enlaces. -->
  <div class="book-gallery pointer-events-none absolute inset-0 z-30 flex items-center opacity-0" inert aria-hidden="true">
    <div class="section-wrap">
      <p class="book-gallery-label eyebrow mb-5 text-center">Explore the frames</p>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-5 sm:gap-3">
        {bookPhotos.map((photo, index) => (
          <a class="book-card group relative block overflow-hidden bg-neutral-900" href={photo.href} aria-label={`Explore ${photo.title} collection`}>
            <Image src={photo.image} alt={photo.alt} class="book-image aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105 sm:aspect-[4/5]" width={300} height={400} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .book-inner { padding-top: clamp(6rem, 11svh, 8rem); padding-bottom: clamp(1.5rem, 4svh, 3rem); gap: clamp(.75rem, 2svh, 1.75rem); }
  .book-atmosphere { background: radial-gradient(ellipse 34% 48% at 50% 58%, #47474755, transparent 75%), linear-gradient(90deg, #111 1px, transparent 1px); background-size: auto, 8rem 100%; }
  .book-scene { width: min(30vw, 310px); aspect-ratio: 0.73; perspective: 1600px; }
  .book-wrapper, .page { transform-style: preserve-3d; }
  .page-face { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .page-front { transform: rotateY(0); }
  .page-back { transform: rotateY(180deg); }
  .book-image { filter: grayscale(1) contrast(1.12); }
  .book-cover-photo { filter: grayscale(1) contrast(1.35) brightness(.7); }
  .book-small { font: 700 clamp(.45rem, .65vw, .65rem)/1.5 ui-monospace, SFMono-Regular, monospace; letter-spacing: .14em; }
  .book-bottom .book-small { font-size: .6rem; }
  .book-card { will-change: transform, opacity; }
  .book-gallery { padding-top: clamp(7rem, 14svh, 9rem); padding-bottom: 1.5rem; }
  @media (max-width: 639px) {
    .book-scene { width: min(41vw, 185px); }
    .book-gallery { padding-top: 7.5rem; }
    .book-gallery .book-image { height: min(12svh, 100px); }
  }
  @media (max-height: 650px) {
    .book-inner { padding-top: 6.5rem; padding-bottom: 1.25rem; gap: .5rem; }
    .book-scene { width: min(23vw, 230px); }
    .book-gallery .book-image { height: 20svh; }
  }
  /* Una alternativa estática mantiene las fotos disponibles sin forzar animaciones. */
  .motion-reduced { overflow: visible; }
  .motion-reduced .book-inner { min-height: auto; padding-bottom: 2rem; }
  .motion-reduced .book-gallery { position: relative; opacity: 1; pointer-events: auto; padding-top: 1rem; padding-bottom: 4rem; }
  .motion-reduced .book-bottom { display: none; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-photobook]');
  if (section) {
    const gallery = section.querySelector<HTMLElement>('.book-gallery');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = gsap.utils.toArray<HTMLElement>('.book-card', section);
    if (reduceMotion) {
      section.classList.add('motion-reduced');
      gallery?.removeAttribute('inert');
      gallery?.setAttribute('aria-hidden', 'false');
    } else {
      // Una sola línea de tiempo controla hojas, progreso y revelado final.
      gsap.set(cards, { autoAlpha: 0, y: 24, scale: .97 });
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${Math.max(window.innerHeight * 2.3, 1600)}`,
          scrub: .45,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            gsap.set('.book-progress', { scaleX: self.progress });
            // Los enlaces se pueden usar con teclado solo cuando la galería es visible.
            const galleryVisible = self.progress >= .68;
            gallery?.toggleAttribute('inert', !galleryVisible);
            gallery?.setAttribute('aria-hidden', String(!galleryVisible));
          },
        },
      });
      // Al desplazar medio ancho, el lomo queda centrado y ambas páginas caben en móvil.
      timeline.to('.book-wrapper', { xPercent: 50, duration: 1.2, ease: 'power1.inOut' }, 0)
        .to('.book-cover-front', { rotateY: -180, duration: 1.5, ease: 'power1.inOut' }, 0)
        .to('.page-1', { rotateY: -176, duration: 1.4 }, 1)
        .to('.page-2', { rotateY: -173, duration: 1.4 }, 2)
        .to('.page-3', { rotateY: -170, duration: 1.4 }, 3)
        .to('.page-4', { rotateY: -167, duration: 1.4 }, 4)
        .to('.page-5', { rotateY: -164, duration: 1.4 }, 5)
        .to('.book-scene', { y: -25, scale: .88, autoAlpha: 0, duration: .8, ease: 'power2.in' }, 6.4)
        .to('.book-heading, .book-bottom', { autoAlpha: 0, duration: .4 }, 6.4)
        .to('.book-gallery', { autoAlpha: 1, pointerEvents: 'auto', duration: .5 }, 6.7)
        .to(cards, { autoAlpha: 1, y: 0, scale: 1, duration: .75, stagger: { each: .08, from: 'center' }, ease: 'power2.out' }, 6.9)
        // Una pausa final deja tiempo para mirar la selección antes de seguir bajando.
        .to('.book-gallery', { opacity: 1, duration: 2 }, 8.1);
    }
  }
</script>
