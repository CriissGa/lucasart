---
import {Image} from 'astro:assets';
import {createImageUrlBuilder} from '@sanity/image-url';
import {sanitySettings} from '../../sanity.config.mjs';

const {src, alt = '', width = 1200, height, format, widths, ...attributes} = Astro.props;
const builder = createImageUrlBuilder(sanitySettings);
const isSanity = Boolean(src?.asset?._ref);
const dimensions = isSanity ? src.asset._ref.match(/-(\d+)x(\d+)-/) : null;
const renderedHeight = height ?? (dimensions ? Math.round(width * Number(dimensions[2]) / Number(dimensions[1])) : undefined);
let url;
if (isSanity) {
  let image = builder.image(src).width(width).auto('format').quality(85);
  if (height) image = image.height(height).fit('crop');
  url = image.url();
}
---
{isSanity ? (
  <img src={url} data-local-fallback={src.fallback?.src} srcset={widths?.map((size) => builder.image(src).width(size).auto('format').quality(85).url() + ' ' + size + 'w').join(', ')} alt={src.alt || alt} width={width} height={renderedHeight} loading="lazy" decoding="async" {...attributes} />
) : (
  <Image src={src} alt={alt} width={width} height={height} format={format} widths={widths} {...attributes} />
)}
<script>
  function useLocalImage(image: HTMLImageElement) {
    const fallback = image.dataset.localFallback;
    if (!fallback) return;
    delete image.dataset.localFallback;
    image.removeAttribute('srcset');
    image.removeAttribute('sizes');
    image.src = fallback;
  }
  document.addEventListener('error', (event) => {
    if (event.target instanceof HTMLImageElement) useLocalImage(event.target);
  }, true);
  document.querySelectorAll<HTMLImageElement>('img[data-local-fallback]').forEach((image) => {
    if (image.complete && image.naturalWidth === 0) useLocalImage(image);
  });
</script>
