---
if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();

        const firstname = data.get('first-name');
        const lastname = data.get('last-name');
        const email = data.get('email');
        const subject = data.get('subject');
        const message = data.get('message');

        console.log({
            firstname,
            lastname,
            email,
            subject,
            message
        });
    } catch (error) {
        console.error('Error processing contact form:', error);
    }
}
---

<section class="relative isolate overflow-hidden bg-black px-6 py-24 text-white sm:py-32 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">

        <h2 class="mt-3 text-4xl font-black uppercase tracking-tight text-white sm:text-5xl">
            Get In Touch
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-neutral-400 sm:text-base">
            Email me at:
            <a
                href="mailto:theresawinters101@gmail.com"
                class="text-red-500 transition-colors hover:text-red-400"
            >
                theresawinters101@gmail.com
            </a>
            or fill out the form below.
        </p>
    </div>

    <form action="#" method="POST" class="mx-auto mt-16 max-w-xl sm:mt-20">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
            <div>
                <label
                    for="first-name"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    First name
                </label>

                <div class="mt-2.5">
                    <input
                        id="first-name"
                        type="text"
                        name="first-name"
                        autocomplete="given-name"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div>
                <label
                    for="last-name"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Last name
                </label>

                <div class="mt-2.5">
                    <input
                        id="last-name"
                        type="text"
                        name="last-name"
                        autocomplete="family-name"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div class="sm:col-span-2">
                <label
                    for="email"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Email
                </label>

                <div class="mt-2.5">
                    <input
                        id="email"
                        type="email"
                        name="email"
                        autocomplete="email"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div class="sm:col-span-2">
                <label
                    for="subject"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Subject
                </label>

                <div class="mt-2.5">
                    <input
                        id="subject"
                        type="text"
                        name="subject"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div class="sm:col-span-2">
                <label
                    for="message"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Message
                </label>

                <div class="mt-2.5">
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        required
                        class="block w-full resize-y rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    ></textarea>
                </div>
            </div>
        </div>

        <div class="mt-10">
            <button
                type="submit"
                class="block w-full rounded bg-red-600 px-3.5 py-3 text-center text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-red-950/50 transition-colors hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
            >
                Let's Talk
            </button>
        </div>
    </form>
</section>