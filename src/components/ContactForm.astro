---
// Vercel handles delivery through the server-only /api/contact function.
---

<section class="relative isolate overflow-hidden bg-black px-6 py-14 text-white sm:py-20 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>

        <h2 class="mt-3 text-4xl font-black uppercase tracking-tight text-white sm:text-5xl">
            Get In Touch
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-neutral-400 sm:text-base">
            Email me at:
            <a
                href="mailto:info@lucastaylorphotography.com"
                class="text-red-500 transition-colors hover:text-red-400"
            >
                info@lucastaylorphotography.com
            </a>
            or send me a message using the form below.
        </p>
    </div>

    <form class="mx-auto mt-10 max-w-xl sm:mt-12" method="post" action="/api/contact" data-contact-form data-reveal>
        <div hidden aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2">
            <div>
                <label
                    for="first-name"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    First name
                </label>

                <div class="mt-2.5">
                    <input
                        id="first-name"
                        type="text"
                        name="first-name"
                        maxlength="100"
                        autocomplete="given-name"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div>
                <label
                    for="last-name"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Last name
                </label>

                <div class="mt-2.5">
                    <input
                        id="last-name"
                        type="text"
                        name="last-name"
                        maxlength="100"
                        autocomplete="family-name"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div class="sm:col-span-2">
                <label
                    for="email"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Email
                </label>

                <div class="mt-2.5">
                    <input
                        id="email"
                        type="email"
                        name="email"
                        maxlength="254"
                        autocomplete="email"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div class="sm:col-span-2">
                <label
                    for="subject"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Subject
                </label>

                <div class="mt-2.5">
                    <input
                        id="subject"
                        type="text"
                        name="subject"
                        maxlength="200"
                        required
                        class="block w-full rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    />
                </div>
            </div>

            <div class="sm:col-span-2">
                <label
                    for="message"
                    class="block text-xs font-semibold uppercase tracking-widest text-neutral-300"
                >
                    Message
                </label>

                <div class="mt-2.5">
                    <textarea
                        id="message"
                        name="message"
                        maxlength="5000"
                        rows="5"
                        required
                        class="block w-full resize-y rounded border border-neutral-800 bg-neutral-950/80 px-3.5 py-2.5 text-base text-white outline-none placeholder:text-neutral-600 transition-colors focus:border-red-600 focus:ring-1 focus:ring-red-600"
                    ></textarea>
                </div>
            </div>
        </div>

        <div class="mt-7">
            <button
                type="submit"
                class="block w-full rounded bg-red-600 px-3.5 py-3 text-center text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-red-950/50 transition-colors hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
            >
                Send Message
            </button>
        </div>
        <p class="mt-4 text-sm text-neutral-300" role="status" aria-live="polite" data-contact-status></p>
        <noscript><p class="mt-4 text-sm text-neutral-300">Please enable JavaScript to use this form, or email info@lucastaylorphotography.com directly.</p></noscript>
    </form>
</section>

<script>
    document.querySelector<HTMLFormElement>('[data-contact-form]')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
        if (button.disabled) return;
        button.disabled = true;
        button.textContent = 'Sending…';
        status.textContent = 'Sending your message…';
        form.setAttribute('aria-busy', 'true');
        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(Object.fromEntries(new FormData(form))),
                signal: AbortSignal.timeout(25000),
            });
            const result = await response.json();
            if (!response.ok || result.ok !== true) throw new Error(result.error || 'Your message could not be sent. Please try again.');
            status.textContent = 'Thank you! Your message has been sent.';
            form.reset();
        } catch (error) {
            status.textContent = error instanceof Error && error.name === 'Error'
                ? error.message
                : 'We could not confirm delivery. Please try again later or email info@lucastaylorphotography.com directly.';
        } finally {
            button.disabled = false;
            button.textContent = 'Send Message';
            form.removeAttribute('aria-busy');
        }
    });
</script>
