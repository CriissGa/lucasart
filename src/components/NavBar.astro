---
// src/components/Navbar.astro
---

<!-- 'fixed top-0 left-0 w-full': Deja la barra pegada arriba en toda la pantalla -->
<!-- 'bg-slate-900/90 backdrop-blur-md': Fondo oscuro semi-transparente con efecto borroso -->
<!-- 'z-50': Hace que la barra siempre quede por encima de las imágenes u otro contenido -->
<header class="fixed top-0 left-0 w-full bg-black backdrop-blur-md text-white z-50 border-b border-slate-800">
	<div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
		
		<!-- LOGO -->
		<a href="#" class="text-2xl tracking-wider text-purple-400">
			LUCAS TAYLOR <span class="text-white">PHOTOGRAPHY</span>
		</a>

		<!-- ENLACES DEL MENÚ -->
		<nav class="hidden md:flex items-center space-x-8 font-medium">
			<!-- 'hover:text-amber-400': Cambia de color a dorado al pasar el mouse -->
			<a href="#portfolio" class="hover:text-purple-400 transition-colors">Portfolio</a>
			<a href="#about" class="hover:text-purple-400 transition-colors">About</a>
			<a href="#collections" class="hover:text-purple-400 transition-colors">Collections</a>
			
			<!-- BOTÓN DE CONTACTO DESTACADO -->
			<a 
				href="#contact" 
				class="bg-gray-400 text-slate-900 px-5 py-2 rounded-full  hover:bg-purple-300 transition-colors shadow-md"
			>
				Contact
			</a>
		</nav>

	</div>
</header>