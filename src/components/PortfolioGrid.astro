---
import Image from './PortfolioImage.astro';
import { getPortfolio } from '../data/content.js';
const { collections, book, siteImages } = await getPortfolio();
---

<section id="work" class="section-wrap py-14 sm:py-20">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-5" data-reveal>
    <div><p class="eyebrow mb-4">The portfolio / Selected stories</p><h2 class="section-title">Three ways<br />to <em>see it.</em></h2></div>
    <p class="max-w-sm text-neutral-400">A small selection from the archive. Every frame has a story beyond the shutter.</p>
  </div>
  <div class="grid gap-4 lg:grid-cols-3">
    {collections.map((collection) => (
      <a href={`/collections/${collection.id}`} class="group relative block overflow-hidden bg-neutral-900" data-reveal aria-label={`View ${collection.title} collection`}>
        <Image src={collection.cover} alt={`${collection.title} photography by Lucas Taylor`} class="h-[480px] w-full object-cover transition-transform duration-700 group-hover:scale-105 sm:h-[580px]" widths={[480, 800]} sizes="(min-width: 1024px) 33vw, 100vw" />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/5 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between p-7">
          <div><p class="eyebrow mb-2">{collection.eyebrow}</p><h3 class="text-4xl font-black uppercase tracking-tight text-white">{collection.title}</h3></div>
          <span class="text-3xl text-white transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true">↗</span>
        </div>
      </a>
    ))}
  </div>
</section>
